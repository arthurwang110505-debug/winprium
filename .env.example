# ============================================================
# Agnes AI API 環境變數範例
# 複製 .env.example 為 .env 使用: cp .env.example .env
# 注意:Vite 只會把「VITE_」開頭的變數暴露給前端,切勿把真正的金鑰提交到 Git。
# ============================================================

# Agnes API 金鑰(到 Agnes 控制台申請)
VITE_AGNES_API_KEY=

# Agnes API Base URL(OpenAI 相容)
VITE_AGNES_BASE_URL=https://apihub.agnes-ai.com

# 模型名稱(可視帳號方案調整)
VITE_AGNES_MODEL=agnes-2.5-flash

# 選填:後端代理完整端點。設定後,前端不直接打 Agnes,
# 而是把 OpenAI 相容請求轉發到這個後端,避免 API Key 暴露在瀏覽器。
# 例如: https://your-backend.example.com/v1/chat/completions
# VITE_AGNES_API_PROXY=
