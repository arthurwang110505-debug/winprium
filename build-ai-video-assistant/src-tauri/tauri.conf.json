{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI 剪輯助理",
  "version": "0.1.0",
  "identifier": "com.winprium.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AI 剪輯助理 · Winprium Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "shortDescription": "打一句話，Agnes AI 幫你剪好影片",
    "longDescription": "AI 影片剪輯助理：聊天 → AI 剪輯 → Timeline → 預覽 → 微調 → 匯出。"
  }
}
